{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "description": "A way of talking to a catalog. One protocol is one collector adapter.",
  "type": "object",
  "required": ["id", "label", "support"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "label": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "support": {"type": "string", "enum": ["supported", "planned", "deferred", "none", "undecided"]},
    "documentation": {"type": "string", "format": "uri"},
    "note": {"type": "string"}
  }
}
