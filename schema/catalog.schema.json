{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "description": "One install of a catalog, database, API or service that serves Swedish data.",
  "type": "object",
  "required": ["id", "label", "type", "software", "endpoint", "status", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9._-]+)*$", "description": "Host of the canonical URL, plus the path when one host carries several installs. Lower case, no scheme, no www."},
    "label": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}, "description": "Name by language."},
    "type": {"type": "string", "enum": ["statistics_database", "indicator_database", "open_data_portal", "geoportal", "research_repository", "api", "file_collection", "other"], "description": "What the install is."},
    "software": {"type": "string", "description": "Id in software.json."},
    "owner": {"type": "string", "description": "Organisation id the data belongs to. Missing only while unresolved; the report lists those."},
    "operator": {"type": "string", "description": "Organisation id that runs the install, when it is not the owner."},
    "endpoint": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/endpoint"}},
    "status": {"type": "string", "enum": ["active", "inactive", "unknown"], "description": "Whether the install answers. Set by the liveness check."},
    "homepage": {"type": "string", "format": "uri"},
    "identifier": {"type": "object", "additionalProperties": false, "properties": {
      "dataportal": {"type": "string", "description": "dataportal.se catalog context, e.g. https://admin.dataportal.se/store/116"},
      "data_europa": {"type": "string", "description": "data.europa.eu catalogue id, e.g. geodata-se"}
    }},
    "same_as": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "source": {"type": "array", "items": {"type": "string", "enum": ["dataportal", "data_europa", "check", "edits"]}},
    "note": {"type": "string"}
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["protocol", "url"],
      "additionalProperties": false,
      "properties": {
        "protocol": {"type": "string", "description": "Id in protocols.json; one protocol is one collector adapter."},
        "url": {"type": "string", "format": "uri", "description": "Base URL the adapter starts from."},
        "language": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2}$"}, "description": "Languages the endpoint serves, when the protocol splits by language."},
        "support": {"type": "string", "enum": ["supported", "planned", "deferred", "none", "undecided"], "description": "Overrides the protocol's support for this install only."},
        "checked": {"type": "object", "required": ["date", "result"], "additionalProperties": false, "properties": {
          "date": {"type": "string", "format": "date", "description": "When the current result was first observed."},
          "result": {"type": "string", "enum": ["ok", "restricted", "error", "unreachable"]},
          "detail": {"type": "string"}
        }},
        "note": {"type": "string"}
      }
    }
  }
}
